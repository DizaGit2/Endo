        <mxCell id="m_bod" value="Body&#10;screens 22–23&#10;body_metrics" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="260" height="90" as="geometry" />
