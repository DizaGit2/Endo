  <diagram id="labparse" name="2. Lab parse sequence">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0" background="#F1EFE8">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ltitle" value="Lab parse pipeline (screens 19 → 20)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>

        <mxCell id="l1" value="1. Flutter&#10;POST /labs (multipart PDF)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3D9CC;strokeColor=#C25A36;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l2" value="2. API validates&#10;MIME / size / magic bytes&#10;rate limiter: 10/day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="320" y="100" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l3" value="3. ClamAV INSTREAM&#10;reject if infected → 422" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6EF;strokeColor=#8A6F5E;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="600" y="100" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l4" value="4. Encrypt with DEK (AES-GCM)&#10;upload to MinIO&#10;lab-uploads/{uid}/{lab}.pdf.enc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6EF;strokeColor=#8A6F5E;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="860" y="100" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l5" value="5. labs row status=parsing&#10;enqueue ParseLabJob" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="1160" y="100" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l6" value="6. Hangfire worker&#10;fetch + decrypt PDF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="1160" y="240" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l7" value="7. PdfPig text extract&#10;layout-aware" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="860" y="240" width="260" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l8" value="8. LLM call (Anthropic/OpenAI)&#10;strict JSON schema&#10;zero-retention" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;strokeWidth=2;dashed=1;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="600" y="240" width="220" height="80" as="geometry" />
        </mxCell>

        <mxCell id="l9" value="9. Validate&#10;hormone ∈ whitelist&#10;unit ∈ whitelist&#10;value ∈ 1.5× ref range&#10;date ≤ today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=11;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="240" height="100" as="geometry" />
        </mxCell>

        <mxCell id="l10" value="10. Insert lab_result_drafts&#10;(encrypted)&#10;labs.status = needs_manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6EF;strokeColor=#8A6F5E;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="220" height="90" as="geometry" />
        </mxCell>

        <mxCell id="l11" value="11. Push notification&#10;&quot;Your lab is ready to review&quot;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEEDFE;strokeColor=#7F77DD;strokeWidth=2;dashed=1;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="400" width="220" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l12" value="12. User opens screen 20&#10;reviews drafts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3D9CC;strokeColor=#C25A36;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="320" y="400" width="240" height="70" as="geometry" />
        </mxCell>

        <mxCell id="l13" value="13. POST /labs/{id}/confirm&#10;promote drafts → lab_results&#10;labs.status = confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="600" y="400" width="260" height="80" as="geometry" />
        </mxCell>

        <mxCell id="l14" value="14. Trigger matview refresh&#10;(debounced per user)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6EF;strokeColor=#8A6F5E;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="900" y="400" width="240" height="80" as="geometry" />
        </mxCell>

