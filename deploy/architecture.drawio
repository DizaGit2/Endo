        <mxCell id="le10" style="endArrow=classic;html=1;strokeColor=#3B2A20;strokeWidth=1.5" edge="1" parent="1" source="l10" target="l11"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le11" style="endArrow=classic;html=1;strokeColor=#3B2A20;strokeWidth=1.5" edge="1" parent="1" source="l11" target="l12"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le12" style="endArrow=classic;html=1;strokeColor=#3B2A20;strokeWidth=1.5" edge="1" parent="1" source="l12" target="l13"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="le13" style="endArrow=classic;html=1;strokeColor=#3B2A20;strokeWidth=1.5" edge="1" parent="1" source="l13" target="l14"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="lfail" value="Any validation failure → labs.status = needs_manual · user edits on screen 20 · no auto-persist" style="text;html=1;strokeColor=#C25A36;fillColor=#F3D9CC;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="560" width="1340" height="40" as="geometry" />
        </mxCell>

        <mxCell id="lquota" value="Quota: per-user daily LLM-parse budget in ref_insight_rule (default 10) · exceeded → skip step 8, go straight to needs_manual" style="text;html=1;strokeColor=#8A6F5E;fillColor=#FAF6EF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="1340" height="40" as="geometry" />
        </mxCell>

        <mxCell id="lretry" value="Retry policy: Hangfire 3× exponential backoff on transient LLM 5xx / network · non-retryable schema errors → needs_manual + push" style="text;html=1;strokeColor=#8A6F5E;fillColor=#FAF6EF;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="1340" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="modules" name="3. Module map">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0" background="#F1EFE8">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="mtitle" value="Bounded contexts inside the .NET API" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="800" height="30" as="geometry" />
        </mxCell>

        <mxCell id="m_onb" value="Onboarding&#10;screens 1–7&#10;users · user_profile_enc · baseline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3D9CC;strokeColor=#C25A36;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_cyc" value="Cycle&#10;screens 8, 10, 11, 14&#10;cycle_events · cycle_day_logs · insight_snapshot" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="360" y="100" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_sym" value="Symptoms&#10;screens 9, 12, 13&#10;symptoms (region + intensity)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="680" y="100" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_hor" value="Hormones&#10;screens 15–21&#10;labs · lab_result_drafts · lab_results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="980" y="100" width="280" height="90" as="geometry" />
