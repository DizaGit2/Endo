        <mxCell id="m_act" value="Activity&#10;screens 24–25&#10;activity_entries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="360" y="240" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_trt" value="Treatment&#10;screens 26–27&#10;medications · schedules · logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="680" y="240" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_rep" value="Reports&#10;screens 28–30&#10;reports · QuestPDF rendering" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3D9CC;strokeColor=#C25A36;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="980" y="240" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_set" value="Settings&#10;screens 31–37&#10;export · crypto-shred · notif prefs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="380" width="260" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_adm" value="Admin (internal only)&#10;no mobile screens&#10;ref_* tables · audit log" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6EF;strokeColor=#8A6F5E;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="360" y="380" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="m_shared" value="Shared infrastructure&#10;Hangfire · Vault crypto context · MinIO client · FCM/APNs · LLM client · Serilog + OTel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCF7;strokeColor=#8A6F5E;strokeWidth=2;dashed=1;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="680" y="380" width="580" height="90" as="geometry" />
        </mxCell>

        <mxCell id="me_rep_hor" style="endArrow=classic;html=1;strokeColor=#C25A36;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#F1EFE8" edge="1" parent="1" source="m_rep" target="m_hor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me_rep_cyc" style="endArrow=classic;html=1;strokeColor=#C25A36;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#F1EFE8" edge="1" parent="1" source="m_rep" target="m_cyc"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me_rep_sym" style="endArrow=classic;html=1;strokeColor=#C25A36;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#F1EFE8" edge="1" parent="1" source="m_rep" target="m_sym"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me_rep_trt" style="endArrow=classic;html=1;strokeColor=#C25A36;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#F1EFE8" edge="1" parent="1" source="m_rep" target="m_trt"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me_cyc_sym" style="endArrow=classic;html=1;strokeColor=#7B8F6B;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#F1EFE8" edge="1" parent="1" source="m_cyc" target="m_sym"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me_cyc_hor" style="endArrow=classic;html=1;strokeColor=#7B8F6B;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#F1EFE8" edge="1" parent="1" source="m_cyc" target="m_hor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me_trt_adm" style="endArrow=classic;html=1;strokeColor=#8A6F5E;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#F1EFE8" edge="1" parent="1" source="m_trt" target="m_adm"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="me_hor_adm" style="endArrow=classic;html=1;strokeColor=#8A6F5E;strokeWidth=1.5;dashed=1;fontSize=10;labelBackgroundColor=#F1EFE8" edge="1" parent="1" source="m_hor" target="m_adm"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="m_jobs" value="Background jobs map&#10;&#10;ParseLabJob  ←  Hormones&#10;GenerateDoctorReportJob  ←  Reports&#10;NightlyNotificationDispatchJob  ←  Settings (reads Treatment, Cycle)&#10;RefreshMatviewsJob  ←  Hormones, Cycle, Reports&#10;RecomputeInsightSnapshotJob  ←  Cycle&#10;BuildDataExportJob  ←  Settings&#10;CryptoShredJob  ←  Settings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCF7;strokeColor=#7B8F6B;strokeWidth=2;fontSize=11;fontColor=#3B2A20;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="600" height="210" as="geometry" />
        </mxCell>

        <mxCell id="m_legend" value="Edge colours&#10;&#10;Terracotta solid — Reports aggregates other modules&#10;Sage dashed — cross-read between core modules&#10;Muted dashed — reference-data read from Admin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFCF7;strokeColor=#8A6F5E;strokeWidth=2;fontSize=11;fontColor=#3B2A20;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="700" y="520" width="560" height="130" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="crypto" name="4. Encryption flow">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0" background="#F1EFE8">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ctitle" value="Per-user envelope encryption + crypto-shred" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=18;fontStyle=1;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="30" as="geometry" />
        </mxCell>

        <mxCell id="c_vault" value="Vault — Transit engine&#10;named key: lumen-prod-kek&#10;(KEK never leaves Vault)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="100" width="320" height="100" as="geometry" />
        </mxCell>

        <mxCell id="c_keys" value="user_keys table&#10;(user_id, wrapped_dek, key_version, vault_key_name)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6EF;strokeColor=#8A6F5E;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="260" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c_api" value="API request or Hangfire job&#10;IUserCryptoContext (request-scoped)&#10;1. load wrapped_dek&#10;2. Vault decrypt → plaintext DEK (in-memory)&#10;3. use DEK for this request only&#10;4. discard when scope ends" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E4EADD;strokeColor=#7B8F6B;strokeWidth=2;fontSize=12;fontColor=#3B2A20;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="480" y="100" width="420" height="160" as="geometry" />
        </mxCell>

        <mxCell id="c_enc_db" value="Encrypted Postgres columns (bytea)&#10;&#10;user_profile_enc · notes_enc · value_enc · unit_enc&#10;ref_low_enc · ref_high_enc · dose_enc&#10;missing_data_cards_enc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6EF;strokeColor=#8A6F5E;strokeWidth=2;fontSize=12;fontColor=#3B2A20;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1000" y="100" width="400" height="140" as="geometry" />
        </mxCell>

        <mxCell id="c_enc_minio" value="Encrypted MinIO objects&#10;&#10;lab-uploads/{uid}/{lab}.pdf.enc&#10;reports/{uid}/{report}.pdf.enc&#10;exports/{uid}/{job}.zip.enc" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6EF;strokeColor=#8A6F5E;strokeWidth=2;fontSize=12;fontColor=#3B2A20;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1000" y="280" width="400" height="140" as="geometry" />
        </mxCell>

        <mxCell id="c_signup" value="On user signup&#10;API generates 256-bit DEK locally&#10;→ Vault wrap → store wrapped_dek" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3D9CC;strokeColor=#C25A36;strokeWidth=2;fontSize=12;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="440" width="320" height="90" as="geometry" />
        </mxCell>

        <mxCell id="c_shred" value="Right-to-erasure (DELETE /me)&#10;1. disable Keycloak user&#10;2. enqueue CryptoShredJob&#10;3. DELETE user_keys row&#10;4. delete MinIO objects under {uid}/&#10;5. tombstone users row&#10;6. write admin_audit_log&#10;&#10;Ciphertext in backups becomes permanently unreadable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3D9CC;strokeColor=#C25A36;strokeWidth=3;fontSize=12;fontColor=#3B2A20;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="480" y="440" width="420" height="220" as="geometry" />
        </mxCell>

        <mxCell id="c_backup" value="Postgres + MinIO nightly backups&#10;off-site EU bucket&#10;&#10;Dumps contain ciphertext only.&#10;Without Vault KEK → useless.&#10;After crypto-shred → the user's&#10;data inside historical backups&#10;cannot be recovered." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF6EF;strokeColor=#8A6F5E;strokeWidth=2;dashed=1;fontSize=11;fontColor=#3B2A20;align=left;verticalAlign=top" vertex="1" parent="1">
          <mxGeometry x="1000" y="460" width="400" height="200" as="geometry" />
        </mxCell>

        <mxCell id="ce1" value="wrap / unwrap" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#7B8F6B;strokeWidth=2;fontSize=10;labelBackgroundColor=#F1EFE8;fontColor=#3B2A20" edge="1" parent="1" source="c_vault" target="c_api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce2" value="load wrapped_dek" style="endArrow=classic;html=1;strokeColor=#8A6F5E;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#F1EFE8;fontColor=#3B2A20" edge="1" parent="1" source="c_keys" target="c_api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce3" value="AES-256-GCM" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#8A6F5E;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#F1EFE8;fontColor=#3B2A20" edge="1" parent="1" source="c_api" target="c_enc_db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce4" value="AES-256-GCM + per-object IV" style="endArrow=classic;startArrow=classic;html=1;strokeColor=#8A6F5E;strokeWidth=1.5;fontSize=10;labelBackgroundColor=#F1EFE8;fontColor=#3B2A20" edge="1" parent="1" source="c_api" target="c_enc_minio"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce5" value="provision" style="endArrow=classic;html=1;strokeColor=#C25A36;strokeWidth=2;fontSize=10;labelBackgroundColor=#F1EFE8;fontColor=#3B2A20" edge="1" parent="1" source="c_signup" target="c_keys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce6" value="destroy key row" style="endArrow=classic;html=1;strokeColor=#C25A36;strokeWidth=2;fontSize=10;labelBackgroundColor=#F1EFE8;fontColor=#3B2A20" edge="1" parent="1" source="c_shred" target="c_keys"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce7" value="" style="endArrow=classic;html=1;strokeColor=#8A6F5E;strokeWidth=1.5;dashed=1" edge="1" parent="1" source="c_enc_db" target="c_backup"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ce8" value="" style="endArrow=classic;html=1;strokeColor=#8A6F5E;strokeWidth=1.5;dashed=1" edge="1" parent="1" source="c_enc_minio" target="c_backup"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="c_note" value="DEK plaintext lives only inside the request/job scope in process memory. It is never written to disk, never logged, never placed in caches beyond the scope." style="text;html=1;strokeColor=#C25A36;fillColor=#F3D9CC;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=11;fontColor=#3B2A20" vertex="1" parent="1">
          <mxGeometry x="60" y="720" width="1340" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
