{
  "realm": "lumen",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and maxLength(128) and notUsername and notEmail",
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 2592000,
  "ssoSessionMaxLifespan": 2592000,
  "roles": {
    "realm": [
      { "name": "lumen-admin", "description": "Lumen operator/admin role gating /admin." }
    ]
  },
  "clients": [
    {
      "clientId": "api",
      "name": "Lumen API (confidential)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "dev-api-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "redirectUris": [],
      "protocolMappers": [
        {
          "name": "lumen-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "lumen-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "mobile",
      "name": "Lumen Flutter client (public, PKCE)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["com.lumen.app:/oauth2redirect"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "com.lumen.app:/oauth2redirect"
      },
      "protocolMappers": [
        {
          "name": "lumen-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "lumen-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "service-account-api",
      "enabled": true,
      "serviceAccountClientId": "api",
      "clientRoles": {
        "realm-management": ["manage-users"]
      }
    }
  ]
}
