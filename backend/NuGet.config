<?xml version="1.0" encoding="utf-8"?>
<!-- Pin restores to nuget.org only, so the build is reproducible and does not
     depend on any machine-level private feed (e.g. an inherited authenticated source). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
